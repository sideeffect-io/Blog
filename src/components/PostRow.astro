---
import type { Post } from '../lib/content';
import { excerpt, formatDate, postSlug, readingMinutes, tagsFor } from '../lib/content';
const { post, featured = false, excerptLength = 220 } = Astro.props as {
  post: Post;
  featured?: boolean;
  excerptLength?: number;
};
const tags = tagsFor(post);
const minutes = readingMinutes(post);
---

<article class:list={['post-row', { featured }]}>
  <div class="post-row-meta">
    <time datetime={post.data.date?.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{tags[0] ?? 'Architecture'}</span>
    <span class="reading-time">{minutes} min read</span>
  </div>
  <div class="post-row-content">
    <h3><a href={`/posts/${postSlug(post)}/`}>{post.data.title}</a></h3>
    {post.data.description && <p>{excerpt(post.data.description, excerptLength)}</p>}
  </div>
  <a class="arrow-link" href={`/posts/${postSlug(post)}/`} aria-label={`Read ${post.data.title}`}>↗</a>
</article>
