---
import Logo from './Logo.astro';
const currentPath = Astro.url.pathname;
const links = [
  { href: '/posts/', label: 'Blog' },
  { href: '/me/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
];
---

<header class="site-header">
  <div class="header-inner">
    <Logo />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
      <span class="menu-label">Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav class="site-nav" id="site-navigation" aria-label="Primary navigation">
      {links.map((link) => (
        <a class:list={{ active: currentPath.startsWith(link.href) }} href={link.href}>{link.label}</a>
      ))}
      <a class="header-contact" href="mailto:thibault@sideeffect.io">Contact <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.querySelector<HTMLElement>('.site-nav');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    navigation?.removeAttribute('data-open');
  };

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    navigation?.toggleAttribute('data-open', open);
  });

  navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
