---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const page = await getEntry('pages', 'projects');
if (!page) throw new Error('Missing projects page');
const { Content } = await render(page);
---

<BaseLayout title="Projects — Side Effect" description="Open source projects and frameworks from Side Effect.">
  <section class="page-intro"><p class="section-kicker">Open source</p><h1>Things I build<br /><em>to learn.</em></h1><p class="page-lede">Libraries, experiments, and collaborations created to make difficult software ideas easier to use.</p></section>
  <div class="projects-layout" data-reveal>
    <aside class="projects-aside"><span class="projects-mark">Open<br /><em>source</em></span><p>Most of my work lives where architecture meets day-to-day developer experience.</p></aside>
    <div class="prose project-prose"><Content /></div>
  </div>
</BaseLayout>
