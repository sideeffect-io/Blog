---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/i18n';
const locale = 'fr';
const text = copy[locale];
const page = await getEntry('pages', 'fr/projects');
if (!page) throw new Error('Missing French projects page');
const { Content } = await render(page);
---

<BaseLayout locale={locale} title={text.projects.title} description={text.projects.description}>
  <section class="page-intro"><p class="section-kicker">{text.projects.kicker}</p><h1>{text.projects.headingBefore}<br /><em>{text.projects.headingEmphasis}</em></h1><p class="page-lede">{text.projects.lede}</p></section>
  <div class="projects-layout" data-reveal>
    <aside class="projects-aside"><span class="projects-mark">{text.projects.markBefore}<br /><em>{text.projects.markEmphasis}</em></span><p>{text.projects.aside}</p></aside>
    <div class="prose project-prose"><Content /></div>
  </div>
</BaseLayout>
