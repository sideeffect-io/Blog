---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostRow from '../../../components/PostRow.astro';
import { postsByDate, postsForLocale } from '../../../lib/content';
import { copy } from '../../../lib/i18n';
const locale = 'fr';
const text = copy[locale];
const posts = postsByDate(postsForLocale(await getCollection('posts'), locale));
---

<BaseLayout locale={locale} title={text.posts.title} description={text.posts.description}>
  <section class="page-intro"><p class="section-kicker">{text.posts.kicker}</p><h1>{text.posts.headingBefore}<br /><em>{text.posts.headingEmphasis}</em></h1><p class="page-lede">{text.posts.lede}</p></section>
  <section class="archive section-rule" data-reveal><div class="archive-heading"><span>{text.posts.articleCount(posts.length)}</span><span>{text.posts.range}</span></div><div class="post-list">{posts.map((post) => <PostRow post={post} locale={locale} />)}</div></section>
</BaseLayout>
