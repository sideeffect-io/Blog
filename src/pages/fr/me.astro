---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileContact from '../../components/ProfileContact.astro';
import { copy } from '../../lib/i18n';
const locale = 'fr';
const text = copy[locale];
const page = await getEntry('pages', 'fr/me');
if (!page) throw new Error('Missing French me page');
const { Content } = await render(page);
---

<BaseLayout locale={locale} title={text.about.title} description={text.about.description}>
  <section class="page-intro about-intro"><p class="section-kicker">{text.about.kicker}</p><h1>{text.about.headingBefore}<br /><em>{text.about.headingEmphasis}</em></h1><p class="page-lede">{text.about.lede}</p></section>
  <div class="about-layout" data-reveal>
    <aside class="profile-card">
      <figure>
        <img src="/images/cotentin.jpeg" alt={text.about.imageAlt} />
        <figcaption>{text.about.caption}</figcaption>
      </figure>
      <nav class="about-nav" aria-label={text.about.onThisPage}>
        <span>{text.about.onThisPage}</span>
        <a href="#about">{text.about.about} <b>01</b></a>
        <a href="#resume">{text.about.resume} <b>02</b></a>
        <a href="#talks">{text.about.talks} <b>03</b></a>
      </nav>
      <ProfileContact locale={locale} />
    </aside>
    <div class="prose about-prose"><Content /></div>
  </div>
</BaseLayout>
