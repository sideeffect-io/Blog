---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { postsByDate, postsForLocale } from '../../lib/content';
import { copy, pathForLocale } from '../../lib/i18n';

const locale = 'fr';
const text = copy[locale];
const posts = postsByDate(postsForLocale(await getCollection('posts'), locale));
const latest = posts.slice(0, 4);
---

<BaseLayout locale={locale}>
  <section class="hero home-hero">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span class="eyebrow-dot"></span> {text.home.eyebrow}</p>
        <h1>{text.home.titleBefore}<br /><em>{text.home.titleEmphasis}</em></h1>
        <p class="hero-lede">{text.home.lede}</p>
        <div class="hero-actions"><a class="button button-dark" href={pathForLocale('/me/', locale)}>{text.home.aboutAction} <span>↗</span></a><a class="text-link" href={pathForLocale('/posts/', locale)}>{text.home.blogAction} <span>↓</span></a></div>
      </div>
      <div class="hero-art reveal reveal-delay" aria-label={text.home.artAlt}>
        <img src="/images/brand/side-effect-dark.jpg" alt={text.home.artAlt} />
        <span class="art-caption">Side Effect / 2026</span>
      </div>
    </div>
  </section>

  <section class="home-intro section-rule" data-reveal>
    <p class="section-kicker">{text.home.contextKicker}</p>
    <div class="intro-grid"><h2>{text.home.contextTitle}</h2><p>{text.home.contextBody}</p></div>
  </section>

  <section class="why-name section-rule" data-reveal>
    <p class="section-kicker">{text.home.nameKicker}</p>
    <div class="intro-grid"><h2>{text.home.nameTitle}</h2><p>{text.home.nameBody}</p></div>
  </section>

  <section class="latest section-rule" data-reveal>
    <div class="section-heading"><div><p class="section-kicker">{text.home.blogKicker}</p><h2>{text.home.blogTitle}</h2></div><a class="text-link" href={pathForLocale('/posts/', locale)}>{text.home.allArticles} <span>↗</span></a></div>
    <div class="post-list">{latest.map((post, index) => <PostRow post={post} locale={locale} featured={index === 0} excerptLength={180} />)}</div>
  </section>

  <section class="home-cta section-rule" data-reveal><p class="section-kicker">{text.home.projectsKicker}</p><div class="cta-grid"><h2>{text.home.projectsTitle}</h2><div><p>{text.home.projectsBody}</p><a class="button button-purple" href={pathForLocale('/projects/', locale)}>{text.home.projectsAction} <span>↗</span></a></div></div></section>
</BaseLayout>
