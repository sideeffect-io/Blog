---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { postsByDate } from '../lib/content';

const posts = postsByDate(await getCollection('posts'));
const latest = posts.slice(0, 4);
---

<BaseLayout>
  <section class="hero home-hero">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span class="eyebrow-dot"></span> Independent software architecture</p>
        <h1>Make complexity<br /><em>work for you.</em></h1>
        <p class="hero-lede">I help mobile teams design systems that stay understandable, testable, and ready for their next chapter.</p>
        <div class="hero-actions"><a class="button button-dark" href="/me/">About the practice <span>↗</span></a><a class="text-link" href="/posts/">Read the journal <span>↓</span></a></div>
      </div>
      <div class="hero-art reveal reveal-delay" aria-label="Side Effect logo">
        <img src="/images/brand/side-effect-dark.jpg" alt="Side Effect logo" />
        <span class="art-caption">Side Effect / 2026</span>
      </div>
    </div>
  </section>

  <section class="home-intro section-rule">
    <p class="section-kicker">01 / The practice</p>
    <div class="intro-grid"><h2>Architecture is a way of making better decisions, earlier.</h2><p>Side Effect is the practice of Thibault Wittemberg, a software architect working at the intersection of mobile product development, functional programming, and pragmatic delivery.</p></div>
  </section>

  <section class="latest section-rule">
    <div class="section-heading"><div><p class="section-kicker">02 / From the journal</p><h2>Notes on building software.</h2></div><a class="text-link" href="/posts/">View all articles <span>↗</span></a></div>
    <div class="post-list">{latest.map((post, index) => <PostRow post={post} featured={index === 0} />)}</div>
  </section>

  <section class="home-cta section-rule"><p class="section-kicker">03 / Open source & collaboration</p><div class="cta-grid"><h2>Good systems leave room for good work.</h2><div><p>Explore the projects, frameworks, and ideas that shape the practice.</p><a class="button button-purple" href="/projects/">Explore projects <span>↗</span></a></div></div></section>
</BaseLayout>
